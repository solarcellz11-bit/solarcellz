# -------------------------------------------------------------
# Solar Cellz × DEP (Direct Energy Partners) Integration Config
# -------------------------------------------------------------

# Server Configuration
PORT=3000
NODE_ENV=development

# DEP DCIDE Distributor Pricing API
# Base URL provided by Ben Vanspringel (Direct Energy Partners)
DEP_API_BASE_URL=https://directenergypartners.com
DCIDE_API_KEY=your_dcide_api_key_here

# Solar Cellz Shopify Store
SHOPIFY_STORE_DOMAIN=store.solarcellzusa.com
# Shopify Admin API Access Token (starts with shpat_...)
# Leave blank or set USE_MOCK_SHOPIFY=true to test without Shopify credentials
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# When true, uses high-fidelity local mock data (58 matched products) instead of calling live Shopify
USE_MOCK_SHOPIFY=true

# Sync & Rate Limiting Settings
# Milliseconds to pause between sequential product PUT requests to avoid 429 throttling
BATCH_DELAY_MS=250
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Lead Time Defaults (DEP max 60 chars)
DEFAULT_LEAD_TIME_IN_STOCK=In stock
DEFAULT_LEAD_TIME_RESTOCK=2-4 weeks

# Alert Notifications (Email & Webhook)
# Alerts are triggered on 401 (bad API key), 409 (SKU conflict), or sync failure
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=nathan@solarcellzusa.com,deven@devenwebstudio.com
ALERT_EMAIL_FROM=alerts@solarcellzusa.com
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Webhook Alert URL (e.g., Slack or Discord webhook)
ALERT_WEBHOOK_URL=

